# ============================================================
# KYUNGSA 환경변수 설정
# 이 파일을 복사하여 .env 파일을 만든 후 실제 값을 입력하세요.
# cp .env.example .env
# ============================================================

# === 공공데이터포털 (data.go.kr) — 키 1개로 모든 API 공유 ===
# 실거래가, 공시지가, 건축물대장 등
PUBLIC_DATA_API_KEY=

# === Vworld (국토정보플랫폼) ===
VWORLD_API_KEY=

# === 카카오 개발자 ===
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 아래는 런타임에 자동 관리 (직접 입력 불필요)
# CODEF_ACCESS_TOKEN=  ← Redis에 저장/갱신

# === CODEF API (등기부등본·공시가격·토지공시지가·시세) ===
# codef.io 에서 발급. OAuth 2.0 Bearer Token 방식.
# accessToken은 7일간 유효 → 메모리 캐싱하여 재사용.
#
# CODEF_SERVICE_TYPE: sandbox | demo | production (기본값: sandbox)
#   sandbox    → CODEF_SANDBOX_* 키 사용 + development.codef.io (고정 응답, 무제한)
#   demo       → CODEF_DEMO_* 키 사용 + development.codef.io (실제 데이터, 일 100회, 3개월)
#   production → CODEF_* 키 사용 + api.codef.io (유료)
CODEF_SERVICE_TYPE=sandbox

# 샌드박스 키 (고정 응답, 무제한 — 개발 초기 테스트용)
CODEF_SANDBOX_CLIENT_ID=
CODEF_SANDBOX_CLIENT_SECRET=

# 데모 키 (실제 데이터, 일 100회, 3개월 — codef.io에서 별도 발급)
CODEF_DEMO_CLIENT_ID=
CODEF_DEMO_CLIENT_SECRET=

# 정식 키 (유료, 프로덕션 배포 시)
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=

# RSA 암호화용 공개키 (CODEF에서 제공)
CODEF_PUBLIC_KEY=

# === 틸코블렛 API (등기부등본 조회 — CODEF 대체) ===
# tilko.net 에서 발급. 건당 포인트 과금.
# 10,000포인트 무료 제공, 이후 44,000원/40,000포인트
#
# TILKO_SERVICE_TYPE: dev | prod (기본값: dev)
#   dev  → dev.tilko.net (개발/테스트)
#   prod → api.tilko.net (운영)
TILKO_SERVICE_TYPE=dev

# 일반용 API KEY (tilko.net → 내정보 → API KEY → 일반용)
TILKO_API_KEY=

# RSA 서버용 공개키 Base64 (tilko.net → 내정보 → API KEY → 상세보기 Base64)
TILKO_RSA_PUBLIC_KEY=

# 인터넷등기소 로그인 및 전자민원캐시는 IROS_* 변수 공유 (아래 섹션 참조)

# === 인터넷등기소 (틸코 등기부 열람용) ===
# ⚠️ 2025-01 등기소 개편 후 '회원 ID 로그인'만 지원 (비회원 전화번호 방식 폐지)
# IROS_PHONE_NO = 인터넷등기소 회원 아이디, IROS_PASSWORD = 회원 비밀번호
IROS_PHONE_NO=
IROS_PASSWORD=

# 전자민원캐시 (건당 700원, https://minwon.cashgate.co.kr)
IROS_EPREPAY_NO=
IROS_EPREPAY_PASS=

# === 한국부동산원 R-ONE Open API (상업용부동산 임대동향조사) ===
# https://www.reb.or.kr/r-one/openapi 에서 발급
REB_API_KEY=

# === OPENAI API (LLM 설명 생성용) ===
OPENAI_API_KEY=

# === DB ===
DATABASE_URL=postgresql://kyungsa:password@localhost:5432/kyungsa_db
REDIS_URL=redis://localhost:6379/0
MONGODB_URL=mongodb://localhost:27017/kyungsa

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook 검증용 시크릿 (setWebhook secret_token 파라미터와 동일)
# ⚠️ 미설정 시 웹훅 엔드포인트가 503으로 비활성화됨
TELEGRAM_WEBHOOK_SECRET=

# === 인증 (Phase I) ===
# ⚠️ 필수. 기본값("change-me-in-production")으로는 토큰 발급/검증이 거부됨.
# 생성 예: openssl rand -hex 32
JWT_SECRET=