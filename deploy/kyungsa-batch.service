[Unit]
Description=KYUNGSA Batch Collector
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=eric
WorkingDirectory=/home/eric/projects/KYUNGSA
ExecStart=/home/eric/projects/KYUNGSA/backend/.venv/bin/python scripts/run_batch.py --all-courts
ExecStart=/home/eric/projects/KYUNGSA/backend/.venv/bin/python scripts/fix_past_due.py
ExecStart=/home/eric/projects/KYUNGSA/backend/.venv/bin/python scripts/send_alerts.py
Environment=PYTHONPATH=/home/eric/projects/KYUNGSA/backend
TimeoutStartSec=14400
StandardOutput=journal
StandardError=journal

# 환경변수 (.env 파일에서 로드)
EnvironmentFile=/home/eric/projects/KYUNGSA/.env
