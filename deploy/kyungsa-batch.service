[Unit]
Description=KYUNGSA Batch Collector (Seoul)
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=eric
WorkingDirectory=/home/eric/projects/KYUNGSA
ExecStart=/home/eric/projects/KYUNGSA/backend/.venv/bin/python scripts/run_batch.py --all-seoul
Environment=PYTHONPATH=/home/eric/projects/KYUNGSA/backend
TimeoutStartSec=14400
# SIGTERM 후 우아 종료(PipelineRun finished_at 기록)에 여유 시간
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal

# 환경변수 (.env 파일에서 로드)
EnvironmentFile=/home/eric/projects/KYUNGSA/.env
